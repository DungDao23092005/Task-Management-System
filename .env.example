# ---------------------------------------------------------------------------
# Application environment template
# Copy this file to ".env" and fill in real values. NEVER commit ".env".
# ---------------------------------------------------------------------------

# Runtime environment: development | test | production
APP_ENV=development

# ---------------------------------------------------------------------------
# Database (Microsoft SQL Server 2022, ODBC Driver 18 via pyodbc)
#
# SQLAlchemy connection string format:
#   mssql+pyodbc://<user>:<password>@<host>:<port>/<database>?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
#
# Notes:
# - The driver name must be URL-encoded ("ODBC+Driver+18+for+SQL+Server").
# - TrustServerCertificate=yes skips certificate validation of the server.
#   Use it ONLY for local development. In production, install a trusted
#   certificate and remove this parameter (or set it to "no").
# - Example (local development):
#   DATABASE_URL=mssql+pyodbc://<user>:<url-encoded-password>@localhost:1433/<database>?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
#
# Leave empty here; never put a real connection string or password in this file.
DATABASE_URL=

# ---------------------------------------------------------------------------
# JWT authentication
#
# JWT_SECRET MUST be replaced with a strong, randomly generated secret.
# Generate one, for example, with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Never reuse a weak or default value. Never commit the real secret.
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------------------------------------------------------------------------
# CORS allowed origins, comma-separated.
# Example: http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=
